<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="500.0" prefHeight="480.0" spacing="15" stylesheets="@welcome-style.css"
      style="-fx-background-color: #F8FAFC; -fx-padding: 30;" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.auction.controller.auction.ItemDetailController">
    
    <!-- Header: Tên Item & Badge Status -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="itemNameLabel" style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #0F172A;" text="Item Name" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="statusLabel" text="STATUS" style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-padding: 5 12; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 12px;" />
    </HBox>
    
    <Separator style="-fx-padding: 5 0;" />
    
    <!-- Scrollable Content -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC; -fx-padding: 0;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox spacing="15">
            <!-- Info Grid -->
            <GridPane hgap="15" vgap="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <columnConstraints>
                    <ColumnConstraints prefWidth="120" halignment="LEFT" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                
                <Label text="Seller" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="sellerLabel" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #0F172A; -fx-font-weight: bold;" />
                
                <Label text="Category" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="categoryLabel" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #0F172A; -fx-font-weight: bold;" />
                
                <Label text="Starting Price" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="startingPriceLabel" text="0.00" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #0F172A;" />
                
                <Label text="Current Bid" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="currentBidLabel" text="0.00" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #2563EB; -fx-font-weight: 900; -fx-font-size: 16px;" />
                
                <Label text="Start Time" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="startTimeLabel" text="—" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-text-fill: #0F172A;" />
                
                <Label text="End Time" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="endTimeLabel" text="—" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-text-fill: #0F172A;" />
            </GridPane>
            
            <!-- Description Box -->
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <Label text="Description" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                <Label fx:id="descriptionLabel" text="—" wrapText="true" minHeight="40" style="-fx-text-fill: #334155;" />
                <Label fx:id="extraInfoLabel" text="" style="-fx-font-style: italic; -fx-text-fill: #94A3B8; -fx-font-size: 12px;" />
            </VBox>
        </VBox>
    </ScrollPane>

    <Region VBox.vgrow="ALWAYS" />
    
    <!-- Bottom Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="bidCountLabel" text="0 bids" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        
        <Button fx:id="btnCancelOrder" onAction="#handleCancelOrder" text="Cancel Order" visible="false" managed="false" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
        <Button fx:id="btnPayNow" onAction="#handlePayNow" text="Pay Now" visible="false" managed="false" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" />
        <Button onAction="#handleClose" text="Close" styleClass="btn-outline" prefWidth="100" />
    </HBox>
</VBox>
