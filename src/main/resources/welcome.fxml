<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.navigation.WelcomeController"
      prefHeight="600" prefWidth="900" stylesheets="@welcome-style.css">

    <!-- PHẦN BÊN TRÁI (60%) - Banner Xanh Nước Biển -->
    <StackPane HBox.hgrow="ALWAYS" prefWidth="540" styleClass="left-pane">
        <Circle radius="180" styleClass="abstract-circle-1" StackPane.alignment="TOP_LEFT" translateX="-60" translateY="-60"/>
        <Circle radius="100" styleClass="abstract-circle-2" StackPane.alignment="BOTTOM_RIGHT" translateX="40" translateY="40"/>
        <Circle radius="60" styleClass="abstract-circle-1" StackPane.alignment="CENTER_RIGHT" translateX="30" translateY="-80"/>

        <VBox alignment="CENTER" spacing="15">
            <Text text="Auction Exchange" style="-fx-fill: white; -fx-font-size: 42px; -fx-font-weight: 900;"/>
            <Text text="Discover exclusive items and bid in real-time." styleClass="subtitle-text" wrappingWidth="320" textAlignment="CENTER"/>
        </VBox>
    </StackPane>

    <!-- PHẦN BÊN PHẢI (40%) - Nút Đăng nhập / Đăng ký -->
    <VBox prefWidth="360" alignment="CENTER" styleClass="right-pane" spacing="30">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="25" VBox.vgrow="ALWAYS">
            <Label text="Get Started" styleClass="form-title"/>
            <Label text="Join the auction system today." style="-fx-text-fill: #64748B;"/>

            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Sign In" onAction="#goToLogin" styleClass="btn-outline" prefWidth="220" prefHeight="45"/>
                <Button text="Sign Up" onAction="#goToRegister" styleClass="btn-filled" prefWidth="220" prefHeight="45"/>
            </VBox>
        </VBox>

        <Label text="© 2026 Auction System Group 7" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
    </VBox>

</HBox>
