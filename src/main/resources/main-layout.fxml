<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            style="-fx-background-color: #F1F5F9;" 
            stylesheets="@welcome-style.css" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.auction.controller.navigation.MainLayoutController">
    
    <!-- SIDEBAR -->
    <left>
        <VBox alignment="TOP_LEFT" prefWidth="230.0" spacing="4.0" 
              style="-fx-background-color: white; -fx-padding: 24 14 24 14; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            
            <!-- Logo / Brand -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 6 0 6;">
                <Circle fill="#2563EB" radius="16.0" />
                <Label style="-fx-font-size: 18px; -fx-text-fill: #0F172A; -fx-font-weight: 900;" text="AuctionHub" />
                <padding>
                    <Insets bottom="20.0" />
                </padding>
            </HBox>

            <!-- Section Header -->
            <Label maxWidth="1.7976931348623157E308" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 10 8 10;" text="MAIN MENU" />

            <!-- Navigation Buttons -->
            <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" 
                    onAction="#showDashboard" styleClass="sidebar-btn, sidebar-btn-active" text="🏠 Dashboard">
                <padding>
                    <Insets bottom="10.0" left="14.0" top="10.0" />
                </padding>
            </Button>

            <Button fx:id="btnMyItems" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" 
                    onAction="#showMyItems" styleClass="sidebar-btn" text="📦 My Items" visible="false" managed="false">
                <padding>
                    <Insets bottom="10.0" left="14.0" top="10.0" />
                </padding>
            </Button>

            <Button fx:id="btnAdminPanel" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" 
                    onAction="#showAdminPanel" styleClass="sidebar-btn" text="🛡 Admin Panel" visible="false" managed="false">
                <padding>
                    <Insets bottom="10.0" left="14.0" top="10.0" />
                </padding>
            </Button>
            
            <!-- Spacer to push user profile to bottom -->
            <VBox VBox.vgrow="ALWAYS" />

            <!-- Section Header for Account -->
            <Label maxWidth="1.7976931348623157E308" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 10 8 10;" text="ACCOUNT" />
            
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 10;">
                <Circle fill="#2563EB" radius="14.0" />
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="userNameLabel" style="-fx-text-fill: #0F172A; -fx-font-weight: bold; -fx-font-size: 13px;" text="Username" />
                    <Label fx:id="userRoleLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="Role" />
                </VBox>
            </HBox>

            <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" 
                    onAction="#handleLogout" styleClass="sidebar-btn" text="🚪 Logout">
                <padding>
                    <Insets bottom="10.0" left="14.0" top="10.0" />
                </padding>
            </Button>

        </VBox>
    </left>
    
    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F1F5F9; -fx-padding: 0;">
            <!-- Nội dung các màn hình (auction.fxml, my-items.fxml) sẽ được nhét vào đây -->
        </StackPane>
    </center>

</BorderPane>
