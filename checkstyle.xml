<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <!-- Đặt mức độ nghiêm trọng mặc định là warning để không làm lỗi build của sinh viên -->
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <module name="TreeWalker">
        <!-- Quy tắc đặt tên Class/Interface (phải viết hoa chữ cái đầu - PascalCase) -->
        <module name="TypeName">
            <property name="severity" value="warning"/>
        </module>

        <!-- Quy tắc đặt tên Method (viết thường chữ cái đầu - camelCase) -->
        <module name="MethodName">
            <property name="severity" value="warning"/>
        </module>

        <!-- Quy tắc đặt tên Biến thành viên (camelCase) -->
        <module name="MemberName">
            <property name="severity" value="warning"/>
        </module>

        <!-- Quy tắc đặt tên Biến cục bộ (camelCase) -->
        <module name="LocalVariableName">
            <property name="severity" value="warning"/>
        </module>

        <!-- Kiểm tra các khối mã trống rỗng (empty block) -->
        <module name="EmptyBlock">
            <property name="severity" value="warning"/>
        </module>

        <!-- Phát hiện các import không sử dụng -->
        <module name="UnusedImports">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
